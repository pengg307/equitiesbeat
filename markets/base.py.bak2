"""Base market class"""
from abc import ABC, abstractmethod
import logging
import asyncio
from core.data_provider import DataProvider
from core.signals import detect_signals

log = logging.getLogger(__name__)


class BaseMarket(ABC):
    
    KEY = ""
    NAME = ""
    CURRENCY_SYMBOL = "$"
    DECIMALS = 2
    USE_REAL_DATA = False
    LIMIT_UP = 999
    LIMIT_DN = -999
    UNIT = "symbols"
    
    EXCHANGES = []
    SECTORS = []
    QUICK_FILTERS = []
    INDICES = []
    TRADING_HOURS = []
    
    SIMULATION_VOL = 0.025
    
    def __init__(self):
        self.symbols = []
        self._loaded = False
    
    @abstractmethod
    def get_symbol_list(self):
        pass
    
    @abstractmethod
    def get_quick_key_map(self, symbol):
        pass
    
    async def initialize(self):
        if self._loaded:
            return
        
        templates = self.get_symbol_list()
        log.info("[" + self.KEY + "] Initializing " + str(len(templates)) + " symbols...")
        
        if self.USE_REAL_DATA:
            await self._init_with_real_data(templates)
        else:
            self._init_with_simulation(templates)
        
        self._loaded = True
        
        # Print summary
        live_count = sum(1 for s in self.symbols if not s.get('isSimulated'))
        sim_count = len(self.symbols) - live_count
        if self.USE_REAL_DATA:
            log.info("[" + self.KEY + "] Loaded " + str(len(self.symbols)) + 
                     " symbols (LIVE: " + str(live_count) + ", SIM fallback: " + str(sim_count) + ")")
        else:
            log.info("[" + self.KEY + "] Loaded " + str(len(self.symbols)) + " symbols (all simulated)")
    
    async def _init_with_real_data(self, templates):
        symbols_yf = [t.get('yfSymbol', t['code']) for t in templates]
        
        log.info("[" + self.KEY + "] Fetching real-time data from yfinance...")
        
        # Batch fetch quotes (now with concurrency control)
        quotes = await DataProvider.fetch_yf_batch_quotes(symbols_yf)
        
        # Fetch history in smaller chunks
        histories = []
        chunk_size = 5
        for i in range(0, len(templates), chunk_size):
            chunk = templates[i:i + chunk_size]
            history_tasks = []
            for t in chunk:
                yfs = t.get('yfSymbol', t['code'])
                history_tasks.append(DataProvider.fetch_yf_history(yfs, period="1y"))
            chunk_hists = await asyncio.gather(*history_tasks, return_exceptions=True)
            histories.extend(chunk_hists)
            if i + chunk_size < len(templates):
                await asyncio.sleep(0.1)
        
        sim_fallback_count = 0
        for t, hist in zip(templates, histories):
            yfs = t.get('yfSymbol', t['code'])
            quote = quotes.get(yfs)
            
            if not quote or isinstance(hist, Exception) or not hist or len(hist) < 30:
                sim = DataProvider.simulate_quote(t, self.SIMULATION_VOL)
                self.symbols.append(self._build_symbol(t, sim, sim['ohlcv'], is_sim=True))
                sim_fallback_count += 1
            else:
                self.symbols.append(self._build_symbol(t, quote, hist, is_sim=False))
        
        if sim_fallback_count > 0:
            log.warning("[" + self.KEY + "] " + str(sim_fallback_count) + 
                       " symbol(s) used simulation fallback (yfinance returned no data)")
    
    def _init_with_simulation(self, templates):
        for t in templates:
            sim = DataProvider.simulate_quote(t, self.SIMULATION_VOL)
            self.symbols.append(self._build_symbol(t, sim, sim['ohlcv'], is_sim=True))
    
    def _build_symbol(self, tpl, quote, ohlcv, is_sim):
        sigs = detect_signals(ohlcv)
        last = ohlcv[-1]
        intraday = [d['c'] for d in ohlcv[-60:]]
        amp = ((last['h'] - last['l']) / quote['prevClose'] * 100) if quote.get('prevClose') else 0
        
        result = dict(tpl)
        result.update({
            'price': quote['price'],
            'prevClose': quote['prevClose'],
            'open': quote['open'],
            'high': quote['high'],
            'low': quote['low'],
            'volume': quote['volume'],
            'change': quote['change'],
            'changePct': quote['changePct'],
            'turnover': round(quote['price'] * quote['volume'] / 10000, 2),
            'pe': tpl.get('pe', round(15 + (hash(tpl['code']) % 50), 1)),
            'pb': tpl.get('pb', round(1 + (hash(tpl['code']) % 10) / 2, 2)),
            'marketCap': tpl.get('marketCap', round(quote['price'] * 1000, 2)),
            'amplitude': round(amp, 2),
            'turnoverRate': round(0.5 + (hash(tpl['code']) % 100) / 10, 2),
            'openInterest': tpl.get('oi', 0),
            'intraday': intraday,
            'ohlcv': ohlcv,
            'sigs': sigs,
            'isSimulated': is_sim,
        })
        return result
    
    async def refresh_quotes(self):
        if not self.USE_REAL_DATA:
            self._simulate_tick()
            return
        
        # Only refresh non-simulated symbols (skip the ones that failed yfinance)
        symbols_to_refresh = [s for s in self.symbols if not s.get('isSimulated')]
        if not symbols_to_refresh:
            self._simulate_tick()  # all are sim, just tick them
            return
        
        symbols_yf = [s.get('yfSymbol', s['code']) for s in symbols_to_refresh]
        quotes = await DataProvider.fetch_yf_batch_quotes(symbols_yf)
        
        for s in symbols_to_refresh:
            yfs = s.get('yfSymbol', s['code'])
            q = quotes.get(yfs)
            if q:
                s['price'] = q['price']
                s['change'] = q['change']
                s['changePct'] = q['changePct']
                s['high'] = max(s['high'], q['high'])
                s['low'] = min(s['low'], q['low'])
                s['volume'] = q['volume']
                s['intraday'].append(q['price'])
                if len(s['intraday']) > 60:
                    s['intraday'].pop(0)
        
        # Also tick the simulated symbols
        sim_symbols = [s for s in self.symbols if s.get('isSimulated')]
        import random
        for s in sim_symbols:
            t = (random.random() - 0.5) * s['price'] * 0.002
            np_ = max(s['price'] + t, 0.0001)
            s['price'] = round(np_, self.DECIMALS)
            s['change'] = round(np_ - s['prevClose'], self.DECIMALS)
            s['changePct'] = round(s['change'] / s['prevClose'] * 100, 2)
            s['high'] = max(s['high'], np_)
            s['low'] = min(s['low'], np_)
            s['intraday'].append(np_)
            if len(s['intraday']) > 60:
                s['intraday'].pop(0)
    
    def _simulate_tick(self):
        import random
        for s in self.symbols:
            t = (random.random() - 0.5) * s['price'] * 0.002
            np_ = max(s['price'] + t, 0.0001)
            s['price'] = round(np_, self.DECIMALS)
            s['change'] = round(np_ - s['prevClose'], self.DECIMALS)
            s['changePct'] = round(s['change'] / s['prevClose'] * 100, 2)
            s['high'] = max(s['high'], np_)
            s['low'] = min(s['low'], np_)
            s['intraday'].append(np_)
            if len(s['intraday']) > 60:
                s['intraday'].pop(0)
    
    def to_metadata(self):
        return {
            'key': self.KEY,
            'name': self.NAME,
            'currencySymbol': self.CURRENCY_SYMBOL,
            'decimals': self.DECIMALS,
            'unit': self.UNIT,
            'limitUp': self.LIMIT_UP,
            'limitDn': self.LIMIT_DN,
            'exchanges': self.EXCHANGES,
            'sectors': self.SECTORS,
            'quickFilters': self.QUICK_FILTERS,
            'indices': self.INDICES,
            'tradingHours': self.TRADING_HOURS,
            'useRealData': self.USE_REAL_DATA,
        }
    
    def get_symbols_payload(self):
        return [
            {k: v for k, v in s.items() if k != 'ohlcv'}
            for s in self.symbols
        ]
    
    def get_symbol_detail(self, code):
        for s in self.symbols:
            if s['code'] == code:
                return s
        return None
